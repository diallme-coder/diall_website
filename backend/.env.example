NODE_ENV=production
PORT=3000
APP_ORIGIN=https://contacts.example
DATABASE_URL=postgres://contact_manager:change-me@localhost:5432/contact_manager
# Exactly 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://contacts.example/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://contacts.example/auth/microsoft/callback
